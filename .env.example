# ICCEC 供应商自动审批 - 环境变量配置模板
# 复制本文件为 .env，填入真实值后使用
# 所有敏感字段均为占位符，请勿提交真实凭证到代码仓库

# === asca.iccec.cn 域名 ===
# APP_TOKEN：从浏览器 F12 → Network → 任一审批请求的请求头复制
APP_TOKEN=your_app_token_here

# agentId：从审批页 URL 参数 a= 的值复制
AGENT_ID=your_agent_id_here

# CODE：从审批页 URL 参数 CODE= 的值复制
CODE=your_code_here

# === scpma.iccec.cn 域名 ===
# Cookie：从 F12 请求头复制，格式 key1=val1; key2=val2
# Cookie 会过期（约 1-3 天），过期后通过 Web UI 右上角"更新Cookie"按钮更新
SCPMA_COOKIE=
# Authorization 令牌：从 F12 请求头 Authorization 字段复制
SCPMA_AUTH_TOKEN=

# 组织 ID（从请求体获取，默认 103495 为中国港湾）
ORG_ID=your_org_id_here

# === TextIn OCR 服务 ===
# textin.com 工作台 → 账号设置 → 开发者信息
TEXTIN_APP_ID=your_textin_app_id_here
TEXTIN_SECRET_CODE=your_textin_secret_code_here

# === 运行参数 ===
# 安全开关：true=只模拟不真审批（推荐日常使用），false=真实回写审批结果
DRY_RUN=true
# 同一供应商内 scpma 请求间隔（秒），避免触发风控
REQ_INTERVAL=5
# 供应商之间的间隔（秒）
SUPPLIER_INTERVAL=15
# 仅拉取不审批（调试用），设为 true 时只拉数据不调审批接口
FETCH_ONLY=
# 指定 todoId 列表（逗号分隔），只处理这些待办；留空处理全部
FETCH_IDS=
