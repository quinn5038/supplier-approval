# ICCEC 供应商自动审批 - 环境变量配置模板
# 复制本文件为 .env，填入真实值后使用
# 所有敏感字段均为占位符，请勿提交真实凭证到代码仓库

# === asca.iccec.cn 域名 ===
# APP_TOKEN：按需从浏览器 F12 → Network → asca 待办请求的请求头复制；没有该请求头可留空
APP_TOKEN=

# agentId：按需从审批页 URL 参数 a= 的值复制；没有该参数可留空
AGENT_ID=

# === scpma.iccec.cn 域名 ===
# Cookie：从 F12 请求头复制，格式 key1=val1; key2=val2
# 日常可在网页粘贴 Cookie 和 Authorization，仅存本次进程内存；这里可留空
SCPMA_COOKIE=
# Authorization 令牌：从 F12 请求头 Authorization 字段复制
SCPMA_AUTH_TOKEN=

# 组织 ID（从请求体获取，默认 103495 为中国港湾）
ORG_ID=103495

# === TextIn OCR 服务 ===
# textin.com 工作台 → 账号设置 → 开发者信息
TEXTIN_APP_ID=
TEXTIN_SECRET_CODE=

# === 企查查 API（A10 商业信誉硬拦截项 + 围标串标排查）===
# 申请渠道：公司 IT 共享企业版账号，或企查查开放平台 openapi.qcc.com 个人注册
# 未配置时 qcc_api_client.py 返回空 dict，enhance_checklist_with_qcc 走人工复核路径，不影响现有流程
QCC_APP_KEY=
QCC_SECRET_KEY=
# 企查查 API 域名（实际值看申请到的通道，默认 openapi.qcc.com）
QCC_BASE_URL=https://ai-dataapi.ccccltd.cn
# 调用超时（秒）
QCC_TIMEOUT=15

# === 运行参数 ===
# 安全开关：true=只模拟不真审批（推荐日常使用），false=真实回写审批结果
DRY_RUN=true
# 同一供应商内 scpma 请求间隔（秒），避免触发风控
REQ_INTERVAL=5
# 供应商之间的间隔（秒）
SUPPLIER_INTERVAL=15
# 仅拉取不审批（调试用），设为 true 时只拉数据不调审批接口
FETCH_ONLY=
# 指定 todoId 列表（逗号分隔），只处理这些待办；留空处理全部
FETCH_IDS=

# 默认本机便捷模式无需额外登录。可选 WEB_AUTH_MODE=password 时设置以下密码
# WEB_ADMIN_PASSWORD / WEB_VIEWER_PASSWORD
ENABLE_LIVE_APPROVAL=false
DEMO_MODE=false
