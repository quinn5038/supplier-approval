# .env（真实凭证，禁止提交）
.env
.env_R*
.env.local

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 日志文件
*.log

# 真实供应商数据缓存（含供应商名称、证件号等敏感信息）
cache_v*.json
cache_v*_R*.json
stage2_results*.json
textin_results*.json
qcc_results*.json
progress_v*.jsonl
files_cache/

# 备份文件（_R1~_R99 历史版本，广义匹配所有 _R 后缀的本地副本）
*_R[0-9].py
*_R[0-9][0-9].py
*_R[0-9].yaml
*_R[0-9][0-9].yaml
*_R[0-9].md
*_R[0-9][0-9].md
*_R[0-9].txt
*_R[0-9][0-9].txt
.env.example_R*

# 调试脚本（注意：eval.py 是规则求值器核心代码，不能排除）
_probe_*.py
_test_*.py
debug_*.py
test_*.py

# 临时输出
run_v4_*.txt
preview_*.txt
preview_*.html
_supfiles_probe.json
_cookie_probe.json
_*_probe.json
qcc_api_cache.json
qcc_call_count.json
